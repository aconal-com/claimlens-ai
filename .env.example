# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b is the only text-reasoning model documented as active
# in README §"Model Evaluation History" and journey.md. The previous
# default (phi4) was removed because its JSON output was unreliable.
OLLAMA_MODEL=qwen2.5:7b

# Tesseract Configuration
TESSERACT_DUTCH_LANG=nld
TESSERACT_ENGLISH_LANG=eng

# File Storage
UPLOAD_DIR=uploads
LOG_DIR=logs

# Language Settings
DEFAULT_LANGUAGE=nl

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
